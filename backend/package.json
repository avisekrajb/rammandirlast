{
  "name": "shree-ramchandra-temple-backend",
  "version": "1.0.0",
  "description": "Backend API for Shree Ramchandra Temple",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "set NODE_ENV=production&& node server.js",
    "seed": "node src/scripts/seedAdmin.js",
    "download-geoip-db": "node node_modules/geoip-lite/scripts/download.js",
    "postinstall": "npm run download-geoip-db || echo 'GeoIP database download skipped'"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
